# Token Bot Discord dari Discord Developer Portal (tab "Bot" -> "Reset Token")
DISCORD_TOKEN=your_bot_token_here

# (Opsional) Client ID Aplikasi Bot - Bot otomatis mendeteksi Application ID sendiri jika dikosongkan
CLIENT_ID=

# (Opsional) Guild ID / Server ID jika ingin registrasi slash command instan untuk server tertentu
GUILD_ID=

# (Opsional) ID Akun Discord Pemilik Bot - Kosongkan jika ingin auto-detect dari Developer Portal
BOT_OWNER_ID=
